# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...

# Server
API_PORT=8000

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Max upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# Where uploaded images are stored on disk
UPLOAD_DIR=./uploads

# Database — SQLite by default; set to a Postgres URL in prod.
# Railway provides postgresql://... (auto-normalized to asyncpg).
DATABASE_URL=sqlite+aiosqlite:///./analyses.db

# Object storage — leave S3_BUCKET empty to store images on the local disk.
# Set these to use S3 / Cloudflare R2 (backend becomes fully stateless).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Rate limiting for the analyze endpoints (per client IP)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# Redis for distributed rate-limit + shared cost guard (empty = in-memory).
REDIS_URL=
# Global daily spend cap in USD (0 disables the guard).
DAILY_COST_LIMIT_USD=0

# Claude Vision model (+ optional fallback if the primary is overloaded)
VISION_MODEL=claude-sonnet-5
VISION_FALLBACK_MODEL=
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# Pricing for cost estimation (USD per million tokens)
PRICE_PER_MTOK_INPUT=3.0
PRICE_PER_MTOK_OUTPUT=15.0

# Logging
LOG_LEVEL=INFO
